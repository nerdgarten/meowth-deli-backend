datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// ---------------- ENUMS ----------------
enum Role {
  customer
  driver
  restaurant
  admin
}

enum WeekDay {
  sunday
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
}

enum OrderStatus {
  pending
  preparing
  delivered
  rejected
  success
}

enum PaymentType {
  cash
  mobilebanking
  creditcard
}

enum VerificationStatus {
  pending
  rejected
  approved
}

enum Allergy {
  gluten
  peanuts
  seafood
  dairy
  eggs
  soy
  tree_nuts
  wheat
  fish
  shellfish
}

// ---------------- MODELS ----------------
model User {
  id                       Int      @id @default(autoincrement())
  email                    String   @unique
  password                 String
  accepted_term_of_service Boolean  @default(false)
  accepted_pdpa            Boolean  @default(false)
  is_deleted               Boolean  @default(false)
  created_at               DateTime @default(now()) @db.Timestamptz
  updated_at               DateTime @updatedAt @db.Timestamptz

  role              Role
  customer          Customer?
  driver            Driver?
  restaurant        Restaurant?
  paymentMethods    PaymentMethod[]
  restaurantReviews RestaurantReview[]
  verifyTokens      VerifyToken[]
  resetTokens       ResetToken[]
  reports           Report[]
}

model Customer {
  id                  Int      @id
  firstname           String
  lastname            String
  default_location_id Int?
  image               String?
  tel                 String
  created_at          DateTime @default(now()) @db.Timestamptz
  updated_at          DateTime @updatedAt @db.Timestamptz

  user              User                 @relation(fields: [id], references: [id])
  favorites         FavoriteRestaurant[]
  favoriteDishes    FavoriteDish[]
  orders            Order[]
  driverReviews     DriverReview[]
  allergy           Allergy[]
  customerLocations CustomerLocation[]
  reports           Report[]

  @@index([firstname, lastname])
}

model Driver {
  id                  Int                @id
  verification_status VerificationStatus @default(pending)
  is_available        Boolean            @default(false)
  firstname           String
  lastname            String
  image               String?
  vehicle             String?
  fee_rate            Float              @default(0.1)
  licence             String?
  tel                 String
  created_at          DateTime           @default(now()) @db.Timestamptz
  updated_at          DateTime           @updatedAt @db.Timestamptz
  location_id         Int?

  user     User           @relation(fields: [id], references: [id])
  location Location?      @relation(fields: [location_id], references: [id])
  orders   Order[]
  reviews  DriverReview[]
}

model Restaurant {
  id                  Int                @id
  verification_status VerificationStatus @default(pending)
  is_available        Boolean            @default(false)
  name                String
  banner              String?
  fee_rate            Float              @default(0.1)
  location_id         Int?
  detail              String?
  tel                 String
  created_at          DateTime           @default(now()) @db.Timestamptz
  updated_at          DateTime           @updatedAt @db.Timestamptz

  user      User                 @relation(fields: [id], references: [id])
  location  Location?            @relation(fields: [location_id], references: [id])
  tags      RestaurantTag[]
  times     AvailableTime[]
  dishes    Dish[]
  favorites FavoriteRestaurant[]
  reviews   RestaurantReview[]
  orders    Order[]
}

model RestaurantTag {
  id            Int      @id @default(autoincrement())
  restaurant_id Int
  tag           String
  created_at    DateTime @default(now()) @db.Timestamptz
  updated_at    DateTime @updatedAt @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id])

  @@index([restaurant_id])
}

model AvailableTime {
  id            Int      @id @default(autoincrement())
  restaurant_id Int
  week_day      WeekDay
  opening_time  DateTime @db.Timestamptz
  closing_time  DateTime @db.Timestamptz
  created_at    DateTime @default(now()) @db.Timestamptz
  updated_at    DateTime @updatedAt @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id])

  @@index([restaurant_id])
}

model CustomerLocation {
  id          Int      @id @default(autoincrement())
  customer_id Int
  location_id Int
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @updatedAt @db.Timestamptz

  customer Customer @relation(fields: [customer_id], references: [id])
  location Location @relation(fields: [location_id], references: [id])

  @@index([customer_id])
}

model Location {
  id         Int      @id @default(autoincrement())
  latitude   Float
  longitude  Float
  address    String?
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  orders            Order[]
  drivers           Driver[]
  customerLocations CustomerLocation[]
  restaurants       Restaurant[]
}

model Dish {
  id              Int       @id @default(autoincrement())
  restaurant_id   Int
  name            String
  allergy         Allergy[]
  price           Float
  detail          String?
  image           String?
  is_out_of_stock Boolean   @default(false)
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz

  restaurant  Restaurant     @relation(fields: [restaurant_id], references: [id])
  favorites   FavoriteDish[]
  orderDishes OrderDish[]

  @@index([restaurant_id])
}

model FavoriteRestaurant {
  customer_id   Int
  restaurant_id Int
  created_at    DateTime @default(now()) @db.Timestamptz
  updated_at    DateTime @updatedAt @db.Timestamptz

  customer   Customer   @relation(fields: [customer_id], references: [id])
  restaurant Restaurant @relation(fields: [restaurant_id], references: [id])

  @@id([customer_id, restaurant_id])
}

model FavoriteDish {
  customer_id Int
  dish_id     Int
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @updatedAt @db.Timestamptz

  customer Customer @relation(fields: [customer_id], references: [id])
  dish     Dish     @relation(fields: [dish_id], references: [id])

  @@id([customer_id, dish_id])
}

model PaymentMethod {
  id         Int         @id @default(autoincrement())
  user_id    Int
  title      String
  type       PaymentType
  detail     String
  created_at DateTime    @default(now()) @db.Timestamptz
  updated_at DateTime    @updatedAt @db.Timestamptz

  user     User      @relation(fields: [user_id], references: [id])
  payments Payment[]

  @@index([user_id])
}

model Payment {
  id                Int                @id @default(autoincrement())
  order_id          Int
  payment_method_id Int
  image             String?
  status            VerificationStatus @default(pending)
  created_at        DateTime           @default(now()) @db.Timestamptz
  updated_at        DateTime           @updatedAt @db.Timestamptz

  order         Order         @relation(fields: [order_id], references: [id])
  paymentMethod PaymentMethod @relation(fields: [payment_method_id], references: [id])

  @@index([order_id])
  @@index([payment_method_id])
}

model Order {
  id                   Int         @id @default(autoincrement())
  customer_id          Int
  driver_id            Int?
  restaurant_id        Int
  delivery_location_id Int
  status               OrderStatus @default(pending)
  remark               String?
  total_amount         Float
  driver_fee           Float
  created_at           DateTime    @default(now()) @db.Timestamptz
  updated_at           DateTime    @updatedAt @db.Timestamptz

  location          Location           @relation(fields: [delivery_location_id], references: [id])
  customer          Customer           @relation(fields: [customer_id], references: [id])
  restaurant        Restaurant         @relation(fields: [restaurant_id], references: [id])
  driver            Driver?            @relation(fields: [driver_id], references: [id])
  order_dishes      OrderDish[]
  payments          Payment[]
  restaurantReviews RestaurantReview[]
  driverReviews     DriverReview[]

  @@index([customer_id])
  @@index([driver_id])
}

model OrderDish {
  order_id   Int
  dish_id    Int
  amount     Int      @default(1)
  remark     String?
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  order Order @relation(fields: [order_id], references: [id])
  dish  Dish  @relation(fields: [dish_id], references: [id])

  @@id([order_id, dish_id])
}

model RestaurantReview {
  id            Int      @id @default(autoincrement())
  user_id       Int
  restaurant_id Int
  order_id      Int
  rate          Float
  review_text   String?
  images        String[]
  created_at    DateTime @default(now()) @db.Timestamptz
  updated_at    DateTime @updatedAt @db.Timestamptz

  user       User       @relation(fields: [user_id], references: [id])
  restaurant Restaurant @relation(fields: [restaurant_id], references: [id])
  order      Order      @relation(fields: [order_id], references: [id])

  @@index([restaurant_id])
  @@index([order_id])
}

model DriverReview {
  id          Int      @id @default(autoincrement())
  customer_id Int
  driver_id   Int
  order_id    Int
  rate        Float
  review_text String?
  images      String[]
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @updatedAt @db.Timestamptz

  customer Customer @relation(fields: [customer_id], references: [id])
  driver   Driver   @relation(fields: [driver_id], references: [id])
  order    Order    @relation(fields: [order_id], references: [id])

  @@index([driver_id])
  @@index([order_id])
}

model Report {
  id               Int      @id @default(autoincrement())
  customer_id      Int
  reported_id      Int
  reason           String
  detail           String?
  associated_image String[]
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @updatedAt @db.Timestamptz

  customer Customer @relation(fields: [customer_id], references: [id])
  reported User     @relation(fields: [reported_id], references: [id])

  @@index([customer_id])
  @@index([reported_id])
}

model VerifyToken {
  user_id    Int
  token      String   @id @unique
  created_at DateTime @default(now()) @db.Timestamptz
  expires_at DateTime @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [user_id], references: [id])
}

model ResetToken {
  id         Int       @id @default(autoincrement())
  token      String    @unique
  user_id    Int
  expires_at DateTime? @db.Timestamptz

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
}
